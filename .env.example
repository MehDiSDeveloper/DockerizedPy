# SQLite is the backend both local dev and the deploy run on. On Liara the
# `data/` directory is the mounted persistent disk (see liara.json).
DATABASE_URL=sqlite+aiosqlite:///./data/challenges.db
# Postgres is still wired up (alembic history, docker-compose `db` service);
# point DATABASE_URL here and run `alembic upgrade head` to switch back.
# DATABASE_URL=postgresql+asyncpg://challengeuser:challengepass@db:5432/challengemanager
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-random-value

# The operator account guaranteed on every boot by `app.scripts.seed_admin`,
# which start.sh runs after the schema sync. Leave SEED_ADMIN_EMAIL empty to
# seed nothing. The password only creates a *missing* account -- an existing
# one keeps its own, unless SEED_ADMIN_RESET_PASSWORD=true for one boot.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=مدیر
SEED_ADMIN_RESET_PASSWORD=false

# --- SMS one-time passwords (Kavenegar) ------------------------------------
# Leave KAVENEGAR_API_KEY empty in development: the OTP flow then prints the
# code to the server log instead of texting it, so the whole login runs
# offline like the rest of the stack. Outside development an empty key makes
# every code request fail loudly rather than silently accepting codes nobody
# was sent.
#
# KAVENEGAR_OTP_TEMPLATE is the name of an *approved template* on the
# Kavenegar panel and selects the `verify/lookup` route -- the one meant for
# one-time codes (no sender line to approve, reaches numbers opted out of
# bulk SMS, no night-time window). The template's own text supplies the
# wording around the code; this app only sends the code itself.
#
# KAVENEGAR_SENDER + OTP_SMS_TEXT are the fallback for a deploy that has a
# sender line but no approved template yet. Set one path or the other.
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=
KAVENEGAR_SENDER=
# OTP_SMS_TEXT must contain {code}.
# OTP_SMS_TEXT=کد ورود به چالش: {code}

# --- Web Push (VAPID) -------------------------------------------------------
# Notifications on the phone's own lock screen, for a member who allowed them.
# Generate the pair once with:
#
#     python -m app.scripts.generate_vapid_keys
#
# Leave both empty in development: with no keys the whole subsystem is inert
# -- /push/key answers "unavailable", the settings row never renders, and
# nothing is ever sent. Push is the one feature with no offline fallback, so
# it simply does not exist rather than pretending to work.
#
# Keep the pair once a deploy has it. A browser binds its subscription to the
# public key it was created with, so replacing these silently invalidates
# every device already subscribed -- the same class of decision as rotating
# SECRET_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Where a push service can reach whoever is sending (RFC 8292). Never shown
# to a member.
# VAPID_SUBJECT=mailto:support@chalesh.ir
