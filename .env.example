# SQLite is the backend both local dev and the deploy run on. On Liara the
# `data/` directory is the mounted persistent disk (see liara.json).
DATABASE_URL=sqlite+aiosqlite:///./data/challenges.db
# Postgres is still wired up (alembic history, docker-compose `db` service);
# point DATABASE_URL here and run `alembic upgrade head` to switch back.
# DATABASE_URL=postgresql+asyncpg://challengeuser:challengepass@db:5432/challengemanager
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-random-value
